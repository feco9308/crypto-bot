# Public market data: no Binance API key needed.
WEB_HOST=0.0.0.0
WEB_PORT=8000
SCANNER_DATABASE_URL=sqlite:///data/market.db
SCANNER_QUOTE_ASSET=USDT
SCANNER_NUMBER_OF_MARKETS=50
SCANNER_TIMEFRAME=1h
SCANNER_SCANNER_INTERVAL=300
SCANNER_MINIMUM_QUOTE_VOLUME=5000000
SCANNER_MAXIMUM_SPREAD=0.2
SCANNER_AUTO_WATCHLIST_SIZE=5
SCANNER_TOP_SCORE_SIZE=5
SCANNER_TOP_RISERS_SIZE=5
# JSON file for nested config; optional
# SCANNER_CONFIG=config/scanner.json
# Set a persistent random key before production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SCANNER_SECRET_KEY=

# Paper trading: account starts OFF, enable explicitly by CLI or web.
PAPER_INITIAL_PAPER_BALANCE=1000
PAPER_QUOTE_ASSET=USDT
PAPER_RISK_PER_TRADE_PCT=0.5
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MAX_TOTAL_EXPOSURE_PCT=50
PAPER_MAX_SYMBOL_EXPOSURE_PCT=20
PAPER_DAILY_LOSS_LIMIT_PCT=2
PAPER_MAX_DRAWDOWN_LIMIT_PCT=5
PAPER_MINIMUM_ORDER_VALUE=10
PAPER_PAPER_FEE_PCT=0.1
PAPER_PAPER_SLIPPAGE_PCT=0.05
PAPER_PYRAMIDING=false
PAPER_LOOP_INTERVAL=15
PAPER_MAX_SNAPSHOT_AGE_SECONDS=900
# Execution/mark public quotes; never substitutes a candle close
PAPER_MAX_QUOTE_AGE_SECONDS=10
PAPER_QUOTE_TIMEOUT=5
# PAPER_CONFIG=config/paper.json
MONITOR_HEARTBEAT_INTERVAL=30
MONITOR_STALE_THRESHOLD=120
MONITOR_EVENT_RETENTION_COUNT=500

# Isolated Historical Replay Lab resources (same absolute path for web + worker).
# Default: data/ beside market.db. No Binance API key required.
# REPLAY_DATA_DIR=/home/ndvi/crypto-bot/data
