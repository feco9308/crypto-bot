[Unit]
Description=Isolated Historical Replay Worker (NO LIVE TRADING)
StartLimitIntervalSec=0
# System network-online.target cannot order services in a user manager.
# Public-data requests retry in the application; failures also restart below.

[Service]
Type=simple
WorkingDirectory=/home/ndvi/crypto-bot
Environment=PYTHONUNBUFFERED=1
Environment=REPLAY_DATA_DIR=/home/ndvi/crypto-bot/data
ExecStartPre=/usr/lib/systemd/systemd-time-wait-sync
TimeoutStartSec=120
ExecStart=/home/ndvi/crypto-bot/.venv/bin/python -m crypto_bot.replay.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
Nice=10
CPUQuota=75%
MemoryMax=2G
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=default.target
