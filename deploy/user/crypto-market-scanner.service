[Unit]
Description=Market Scanner
StartLimitIntervalSec=0

[Service]
Type=simple
# User units inherit the ndvi user and groups from the user manager.
WorkingDirectory=/home/ndvi/crypto-bot
EnvironmentFile=/home/ndvi/crypto-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/lib/systemd/systemd-time-wait-sync
TimeoutStartSec=120
ExecStart=/home/ndvi/crypto-bot/.venv/bin/market-scanner scan
Restart=on-failure
RestartSec=5
TimeoutStopSec=1800
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=default.target
