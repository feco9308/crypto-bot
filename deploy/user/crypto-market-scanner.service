[Unit]
Description=Market Scanner

[Service]
Type=simple
User=ndvi
Group=ndvi
WorkingDirectory=/home/ndvi/crypto-bot
EnvironmentFile=/home/ndvi/crypto-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ndvi/crypto-bot/.venv/bin/market-scanner scan
Restart=on-failure
RestartSec=15
TimeoutStopSec=1800
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=default.target
