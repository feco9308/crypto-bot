[Unit]
Description=Paper Trading Engine (NO LIVE TRADING)

[Service]
Type=simple
# User units inherit the ndvi user and groups from the user manager.
WorkingDirectory=/home/ndvi/crypto-bot
EnvironmentFile=/home/ndvi/crypto-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ndvi/crypto-bot/.venv/bin/market-scanner paper run
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=default.target
