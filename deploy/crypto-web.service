[Unit]
Description=Production Gunicorn Dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ndvi
Group=ndvi
WorkingDirectory=/home/ndvi/crypto-bot
EnvironmentFile=/home/ndvi/crypto-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ndvi/crypto-bot/.venv/bin/gunicorn --config /home/ndvi/crypto-bot/gunicorn.conf.py crypto_bot.web.app:create_app()
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ndvi/crypto-bot/data

[Install]
WantedBy=multi-user.target
